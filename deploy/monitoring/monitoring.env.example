# /etc/dixpertia/monitoring.env (#188): read by /usr/local/sbin/dixpertia-check.
# Owned by root, mode 0600: it holds the mailbox password. Never commit the real
# file. When the contact@ password changes (#186), change it here too.

# --- Where the alerts go -------------------------------------------------------------
SMTP_URL="smtps://mailpro2.tn.oxa.host:465"
SMTP_USER="contact@dixpertia.tn"
SMTP_PASSWORD="__CONTACT_MAILBOX_PASSWORD__"
MAIL_FROM="contact@dixpertia.tn"
MAIL_TO="contact@dixpertia.tn"
HOST_LABEL="dixpertia production (102.204.207.34)"

# --- Thresholds (the defaults, shown so they are easy to change) --------------------
DISK_PATHS="/"
DISK_MAX_PERCENT=80
MEM_MIN_PERCENT=10
PG_PORTS="5432 5433"
BACKUP_MAX_AGE_HOURS=26
CERT_HOSTS="dixpertia.tn www.dixpertia.tn staging.dixpertia.tn dokploy.dixpertia.tn"
CERT_MIN_DAYS=14
HEALTH_URLS="https://dixpertia.tn/api/health"
CONTAINERS="dixpertia-api- dixpertia-web-"
# Production only: staging is tested by the team, and its bursts are expected.
API_CONTAINERS="dixpertia-api-"
LOG_WINDOW=5m
MAX_429=30
MAX_401=40
MAX_5XX=10
REMIND_HOURS=12
