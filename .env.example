# Copy this file to .env and fill in the values.
#
# Save it as UTF-8 WITHOUT a BOM. An editor-added BOM makes the first key parse
# as "﻿DATABASE_URL", so it is silently ignored.

# ===== REQUIRED =====
# The application refuses to start if either of these is missing. There are no
# fallback values on purpose: a shared default signing key is a security hole.

# DATABASE_URL: PostgreSQL connection string for the APPLICATION role.
# Must not be a superuser: superusers bypass row-level security (#43).
DATABASE_URL="postgresql://dixpertia_app:PASSWORD@localhost:5432/dixpertia"

# SECRET_KEY: signs JWT access tokens. Minimum 32 characters, unique per
# environment. Never reuse the development value in production - anyone holding
# it can forge a token for any user, including an administrator.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="CHANGE_ME_GENERATE_A_UNIQUE_VALUE_AT_LEAST_32_CHARS"

# ===== OPTIONAL =====
# Token lifetime in minutes (default 60).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email delivery. If unset, send_email() logs a warning and returns False
# instead of failing the request; reminders (#134) are then in-app only.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@dixpertia.com"

# Reminders for invoices stuck in the verification flow (#134). In-app always;
# also by e-mail when the SMTP settings above are filled in. Delays are calendar
# days at a step before a reminder, repeated every such period while the
# invoice stays there. The job runs inside the API every INTERVAL minutes.
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MINUTES=60
# A draft never submitted -> its creator.
REMINDER_DRAFT_DAYS=3
# Submitted, not yet reviewed -> every accountant.
REMINDER_REVIEW_DAYS=2
# Rejected, not corrected -> its creator.
REMINDER_REJECTED_DAYS=2
# Approved, not sent -> its creator. It already has its legal number.
REMINDER_APPROVED_DAYS=1

# The public contact form (#98). Every enquiry is stored and the admins are
# notified in the app; with CONTACT_INBOX and the SMTP settings above filled
# in, it is also e-mailed there. The e-mail goes ONLY to this inbox, never to
# the address the visitor typed, so the form cannot be used to spam anyone.
CONTACT_INBOX=""
# Anti-abuse limits, per hour: one sender (by a hash of their IP) and everyone.
CONTACT_LIMIT_PER_SENDER=5
CONTACT_LIMIT_TOTAL=100

# Brute-force limits (#175). Counted in the database, by a keyed hash of the
# IP address or e-mail, never the address itself.
# Behind a reverse proxy the client IP comes from X-Forwarded-For, which uvicorn
# trusts only from --forwarded-allow-ips (127.0.0.1 by default). The proxy must
# set the header itself; otherwise every visitor counts as the proxy.
# Failed sign-ins on one e-mail before it is locked; the lock lifts as they age
# out of the window. A locked account gets the same answer as a wrong password.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Failed sign-ins from one IP, any account, in that same window. Then 429.
LOGIN_MAX_FAILURES_PER_IP=20
# Password-reset e-mails to one account per hour. Past it, none is sent.
RESET_MAILS_PER_HOUR=3
# Requests to the public routes from one IP per minute. Then 429.
PUBLIC_REQUESTS_PER_MINUTE=20

# Public origin of the frontend. Used to build password-reset links and the
# absolute og:image / og:url in index.html (link previews need absolute URLs).
# No trailing slash.
FRONTEND_URL="http://localhost:3000"

# SCHEMA_DATABASE_URL: used ONLY for schema changes (tables.py, Alembic).
# Connects as dixpertia_owner, which can CREATE and ALTER. The application role
# in DATABASE_URL deliberately cannot. Create both roles with:
#   python db/setup_roles.py --superuser-url postgresql://postgres:PASS@HOST:5432/dixpertia
SCHEMA_DATABASE_URL="postgresql://dixpertia_owner:PASSWORD@localhost:5432/dixpertia"

# The seller printed on every invoice PDF (#194). A value left empty is not
# printed at all: no placeholder ever reaches a real invoice. The matricule
# fiscal, RNE and bank details are waiting for the company's official
# details (#189).
SELLER_NAME="DI Xpertia SUARL"
SELLER_ADDRESS="Rue de Pasteur, Dar Chaabane El Fehri"
SELLER_CITY="8011 Nabeul"
SELLER_PHONE="+216 28 814 729"
SELLER_EMAIL="contact@dixpertia.com"
# Matricule fiscal, and the trade register (RNE) number.
SELLER_TAX_ID=""
SELLER_RNE=""
# Bank details, printed under "Bank details" when at least one is set.
SELLER_BANK_NAME=""
SELLER_BANK_HOLDER=""
SELLER_RIB=""
SELLER_IBAN=""
SELLER_BIC=""
